{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "claims",
    "summary",
    "flow",
    "parts",
    "terms",
    "gotchas",
    "ask_team"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "status",
          "evidence",
          "note"
        ],
        "properties": {
          "item": {
            "type": "string",
            "description": "The triage's item, copied exactly."
          },
          "status": {
            "enum": [
              "needed",
              "done",
              "looks_unused",
              "ask_team",
              "blocked"
            ]
          },
          "evidence": {
            "type": "string",
            "description": "path:line or commit that shows the status; empty when the code holds none."
          },
          "note": {
            "type": "string",
            "description": "One short line: what is missing, what already does it, who to ask or what blocks it."
          }
        }
      },
      "description": "Each of the triage's items, in its order, with what the code shows about it."
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "finding",
          "evidence"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "description": "The ticket's claim about today's code, quoted verbatim and short."
          },
          "finding": {
            "type": "string",
            "description": "What the code shows instead, in one short sentence."
          },
          "evidence": {
            "type": "string",
            "description": "path:line, or the places searched when something is absent."
          }
        }
      },
      "description": "Claims the ticket makes about today's code that the code contradicts. Empty when every claim holds."
    },
    "summary": {
      "type": "string",
      "description": "Two or three sentences on what the area does and where the ticket fits."
    },
    "flow": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "One step of today's flow, naming the file it happens in."
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo",
          "path",
          "role"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "description": "Bare repo directory name."
          },
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "description": "One short line on what the file does here."
          }
        }
      }
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "meaning"
        ],
        "properties": {
          "term": {
            "type": "string"
          },
          "meaning": {
            "type": "string"
          }
        }
      }
    },
    "gotchas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ask_team": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Something the code cannot tell, and who can likely answer."
      }
    }
  }
}
