{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acceptance_criteria",
    "technical_implementation",
    "story_point_criteria",
    "split",
    "elsewhere"
  ],
  "properties": {
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "One plain sentence, no label or headline."
      }
    },
    "technical_implementation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo",
          "files"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "description": "Bare repo directory name, no annotation."
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "new"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "new": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "story_point_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "novelty",
        "risk",
        "dependency",
        "testing",
        "deployment"
      ],
      "properties": {
        "novelty": {
          "enum": [
            "Low",
            "Medium",
            "High"
          ]
        },
        "risk": {
          "enum": [
            "Low",
            "Medium",
            "High"
          ]
        },
        "dependency": {
          "enum": [
            "Low",
            "Medium",
            "High"
          ]
        },
        "testing": {
          "enum": [
            "Low",
            "Medium",
            "High",
            "N/A"
          ]
        },
        "deployment": {
          "enum": [
            "Low",
            "Medium",
            "High"
          ]
        }
      }
    },
    "split": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "story_point_criteria",
          "acceptance_criteria",
          "technical_implementation"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "Parent feature, a dash, then the one behaviour, for example \"Book Management - Deleting Book\"."
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "One user story QA can check in the product: As a <role who uses the screen>, I want <action>, so that <benefit>. No metric definitions."
            }
          },
          "technical_implementation": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repo",
                "files"
              ],
              "properties": {
                "repo": {
                  "type": "string",
                  "description": "Bare repo directory name, no annotation."
                },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "new"
                    ],
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "new": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          },
          "story_point_criteria": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "novelty",
              "risk",
              "dependency",
              "testing",
              "deployment"
            ],
            "properties": {
              "novelty": {
                "enum": [
                  "Low",
                  "Medium",
                  "High"
                ]
              },
              "risk": {
                "enum": [
                  "Low",
                  "Medium",
                  "High"
                ]
              },
              "dependency": {
                "enum": [
                  "Low",
                  "Medium",
                  "High"
                ]
              },
              "testing": {
                "enum": [
                  "Low",
                  "Medium",
                  "High",
                  "N/A"
                ]
              },
              "deployment": {
                "enum": [
                  "Low",
                  "Medium",
                  "High"
                ]
              }
            }
          }
        }
      },
      "description": "Behaviour slices of the ticket. Empty when no split is needed."
    },
    "elsewhere": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "behaviour"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "The other ticket's key, from the list of other open tickets."
          },
          "behaviour": {
            "type": "string",
            "description": "The behaviour left to it, in a few plain words."
          }
        }
      },
      "description": "Behaviours left out of this ticket and its split because another open ticket already delivers them. Empty when none are."
    }
  }
}
