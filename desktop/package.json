{
  "name": "refine-desktop",
  "productName": "refine",
  "version": "0.1.0",
  "private": true,
  "description": "refine as a desktop app",
  "main": "out/main/index.js",
  "scripts": {
    "go:build": "cd .. && go build -o bin/refine ./cmd/refine",
    "dev": "pnpm go:build && electron-vite dev",
    "build": "pnpm go:build && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "pnpm build && electron-builder --mac"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild"]
  }
}
